<!DOCTYPE html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Heatseeker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@700&family=Jost:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--ink:#222;--soft:#767676;--line:#e4e4e4;--bg:#fff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 15px/1.5 Jost,system-ui,sans-serif}
header{padding:30px 20px 0;text-align:center}
h1{margin:0;font:700 clamp(2.4rem,12.5vw,7rem)/.95 "League Spartan","Arial Black",sans-serif;letter-spacing:-.01em;text-transform:uppercase}
header p{margin:14px 0 0;color:var(--soft);font-size:.9rem}
.links{display:flex;justify-content:center;flex-wrap:wrap;gap:8px 30px;margin-top:22px;padding:16px 0;border-bottom:1px solid var(--line)}
.links a{color:var(--ink);text-decoration:none;font-weight:500;font-size:.85rem;letter-spacing:.1em;text-transform:uppercase}
.links a:hover{text-decoration:underline;text-underline-offset:4px}
.sec{font-weight:500;color:var(--ink);text-transform:uppercase;letter-spacing:.06em;margin-right:8px}
.bar{max-width:1100px;margin:0 auto;padding:16px 20px;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;color:var(--soft);font-size:.9rem}
.sp{flex:1}
.f{font:inherit;background:none;border:0;border-bottom:1px solid transparent;padding:2px 0;color:var(--soft);cursor:pointer}
.f[aria-pressed=true]{color:var(--ink);border-bottom-color:var(--ink)}
main{max-width:1100px;margin:0 auto;padding:4px 20px 64px;display:grid;grid-template-columns:repeat(2,1fr);gap:32px 16px}
@media(min-width:700px){main{grid-template-columns:repeat(3,1fr);gap:40px 24px}}
@media(min-width:960px){main{grid-template-columns:repeat(4,1fr)}}
.photo{aspect-ratio:4/5;background:#f3f1ee;position:relative}
.photo img{width:100%;height:100%;object-fit:contain;display:block;mix-blend-mode:multiply}
.sold .photo img{opacity:.35}